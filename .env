# Port configuration
PORT=5173

# Node environment
NODE_ENV=development

# Meeting booking / Google Meet URL
# Replace this with your Google Calendar Appointment Schedule, a direct Google Meet room link, or a Calendly link.
# - If you use Google Calendar (e.g. https://calendar.google.com/calendar/appointments/schedules/... or calendar.app.google) or Calendly, it will embed cleanly as an interactive scheduler.
# - If you use a direct Google Meet room link (e.g. https://meet.google.com/xxx-xxxx-xxx), the app will display a beautiful call-to-action button to open the meeting directly, as standard browser security prevents nesting direct Google Meet pages inside iframes.
BOOKING_URL=https://calendar.google.com/calendar/appointments/schedules/AcZssZ0123456789?gv=true
